<Application x:Class="PillInstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>

    <!-- ============ Pill 配色（纯黑白） ============ -->
    <SolidColorBrush x:Key="Ink"     Color="#000000"/>
    <SolidColorBrush x:Key="Paper"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Soft"    Color="#F4F4F5"/>
    <SolidColorBrush x:Key="Text"    Color="#18181B"/>
    <SolidColorBrush x:Key="Muted"   Color="#71717A"/>
    <SolidColorBrush x:Key="Line"    Color="#E4E4E7"/>
    <SolidColorBrush x:Key="Brand"   Color="#0A0A0A"/>
    <SolidColorBrush x:Key="BrandTxt" Color="#FFFFFF"/>

    <FontFamily x:Key="Sans">Inter, Segoe UI, Microsoft YaHei, sans-serif</FontFamily>

    <!-- ============ 药丸主按钮 ============ -->
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#0A0A0A"/>
      <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="Padding" Value="28,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#27272A"/></Trigger>
              <Trigger Property="IsPressed"  Value="True"><Setter TargetName="bd" Property="Background" Value="#000000"/></Trigger>
              <Trigger Property="IsEnabled"  Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 药丸次要按钮（白底灰边） ============ -->
    <Style x:Key="PillButtonGhost" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#18181B"/>
      <Setter Property="BorderBrush" Value="#E4E4E7"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4F4F5"/></Trigger>
      </Style.Triggers>
    </Style>

    <!-- ============ 输入框（正常方框） ============ -->
    <Style x:Key="PillInput" TargetType="TextBox">
      <Setter Property="Height" Value="42"/>
      <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" CornerRadius="8" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    TextElement.Foreground="{TemplateBinding Foreground}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="14,0" VerticalAlignment="Center"
                            HorizontalScrollBarVisibility="Auto"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#27272A"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 圆形 ghost 关闭按钮 ============ -->
    <Style x:Key="GhostCircle" TargetType="Button">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#B4B4B8"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{StaticResource Sans}"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#3F3F46"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
