<Window x:Class="PillInstaller.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载"
        Width="520" Height="400"
        WindowStyle="None" Background="#FFFFFF"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Sans}">

  <Border Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="72"/>
      </Grid.RowDefinitions>

      <!-- 品牌栏 -->
      <Border Grid.Row="0" Background="{StaticResource Brand}">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
            <Border Width="34" Height="34" CornerRadius="17" Background="#FFFFFF">
              <TextBlock x:Name="UiInitial" Text="P" Foreground="#0A0A0A" FontSize="16" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="UiTitle" Text="卸载" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Style="{StaticResource GhostCircle}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,15,16,0" Click="CloseBtn_Click"/>
        </Grid>
      </Border>

      <!-- 内容 -->
      <StackPanel Grid.Row="1" Margin="32,26,32,0" VerticalAlignment="Top">
        <TextBlock x:Name="Msg" Text="确定要卸载吗？" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
        <StackPanel x:Name="ItemsPanel" Margin="0,18,0,0">
          <TextBlock Text="· 删除开始菜单 / 桌面快捷方式" FontSize="13" Foreground="{StaticResource Text}" Margin="0,0,0,7"/>
          <TextBlock Text="· 清理注册表卸载项" FontSize="13" Foreground="{StaticResource Text}" Margin="0,0,0,7"/>
          <TextBlock Text="· 删除安装目录下的所有文件" FontSize="13" Foreground="{StaticResource Text}" Margin="0,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="Status" Text="" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,20,0,0" Visibility="Collapsed"/>
        <ProgressBar x:Name="Progress" Height="8" Margin="0,16,0,0" Minimum="0" Maximum="100" Value="0"
                     Foreground="{StaticResource Brand}" Background="{StaticResource Soft}" Visibility="Collapsed"/>
      </StackPanel>

      <!-- 底部按钮 -->
      <Grid Grid.Row="2" Margin="32,0,26,26">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="UninstallBtn" Style="{StaticResource PillButton}" Width="120" Content="卸载" Click="UninstallBtn_Click"/>
          <Button Style="{StaticResource PillButtonGhost}" Width="110" Content="取消" Margin="12,0,0,0" Click="CloseBtn_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
